{
  "name": "prsplit",
  "version": "0.1.0",
  "description": "Split large PRs into reviewable chain PRs using AI",
  "type": "module",
  "bin": {
    "prsplit": "./dist/cli/index.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "github",
    "pull-request",
    "code-review",
    "ai",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kMJT000/prsplit.git"
  },
  "bugs": {
    "url": "https://github.com/kMJT000/prsplit/issues"
  },
  "homepage": "https://github.com/kMJT000/prsplit#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "octokit": "^4.1.2",
    "openai": "^4.86.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
